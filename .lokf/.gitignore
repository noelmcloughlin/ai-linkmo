.venv/
__pycache__/
*.pyc
lokf-tables/

# Written into knowledge/ (not this directory) when the bundle is opened as an
# Obsidian vault - directly, or through the root knowledge_bundle link (Step 2)
# - workspace state, not bundle content.
.obsidian/

