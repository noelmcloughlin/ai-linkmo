{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "breaking": true, "release": "minor" },
          { "type": "security", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "node .github/scripts/changelog-release.mjs check",
        "generateNotesCmd": "node .github/scripts/changelog-release.mjs notes ${nextRelease.version}",
        "prepareCmd": "node .github/scripts/changelog-release.mjs promote ${nextRelease.version} $(date -u +%Y-%m-%d) && node .github/scripts/bump-version.mjs ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "pyproject.toml", "uv.lock"],
        "message": "chore(release): ${nextRelease.version} - changelog promoted [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "labels": false,
        "releasedLabels": false
      }
    ]
  ]
}
