#!/bin/bash

# Runs ai-linkmo's command line, the linkmo project's ai_linkmo, with `uv run`.
# Usage: ./ai [arguments]
#
# It asks the running API server, unless --mode local or AI_LINKMO_MODE=local says to
# read the data in this process.

if [ ! -d ".venv" ]
then
    echo
    echo "No directory named ./.venv found in current directory (see docs/install.md)!"
    echo "You can build library as follows (check README.md)"
    echo
    echo '    scl enable gcc-toolset-12 bash'
    echo '    uv cache clean'
    echo '    MAX_JOBS=4 TORCH_CUDA_ARCH_LIST="8.6" uv sync'
    exit 1
fi

## logo
if [ ! -f "lib/frontend/static/mylogo.png" ]; then
    cp .assets/mylogo.png lib/frontend/static/mylogo.png 2>/dev/null || true
fi

export AI_LINKMO_MODE="${AI_LINKMO_MODE:-api}"

# Without arguments, show the help.
if [ "$#" -eq 0 ]; then
    exec uv run -m ai_linkmo --help
fi

exec uv run -m ai_linkmo "$@"
